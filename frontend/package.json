    "rimraf": "^5.0.10",
    "semver": "^7.6.3",
    "shelljs": "^0.8.5",
    "terser-webpack-plugin": "^5.3.11",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "^2.7.16",

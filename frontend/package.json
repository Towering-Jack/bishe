  "engines": {
    "node": ">= 18.0.0",
    "npm": ">= 8.0.0"
  },
  "//overrides": [
    "以下包只作为构建期传递依赖出现，其所在大版本已停止修复安全公告。",
    "它们在运行时（浏览器产物）不会被加载，因此统一抬到已修复版本。",
    "postcss-url / postcss-import 在 postcss 8 下的用法与 7 兼容，构建已验证。"
  ],
  "overrides": {
    "postcss": "$postcss",
    "glob": "^10.5.0",
    "serialize-javascript": "^7.1.2",
    "uuid": "^11.1.1"
  },
  "//resolutions": [
    "resolutions 与上面的 overrides 等价，供 yarn 1 使用；",
    "两个字段必须保持一致，否则 npm 与 yarn 解析出的依赖树会不同。"
  ],
  "resolutions": {
    "postcss": "8.5.28",
    "glob": "^10.5.0",
    "serialize-javascript": "^7.1.2",
    "uuid": "^11.1.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}

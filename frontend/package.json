  "description": "FEBS Front By Vue",
  "author": "mrbrid <https://mrbrid.cc>",
  "private": true,
  "scripts": {
    "dev": "webpack serve --config build/webpack.dev.conf.js",
    "start": "npm run dev",
    "build": "node build/build.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",

    "moment": "^2.30.1",
    "vue": "^2.7.16",
    "vue-apexcharts": "1.6.2",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@vue/babel-preset-jsx": "^1.4.0",
    "@vue/component-compiler-utils": "^3.3.0",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.2.1",
    "chalk": "^4.1.2",
    "compression-webpack-plugin": "^10.0.0",
